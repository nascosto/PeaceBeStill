{
  "name": "peacebestill",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quiet the web down. A family of small, switch-driven extensions, one per site.",
  "scripts": {
    "test": "node --test test/*.test.mjs extensions/*/test/*.test.mjs",
    "lint": "npm run lint:youtube",
    "lint:youtube": "web-ext lint --source-dir extensions/youtube/src --self-hosted",
    "build": "npm run build:youtube",
    "build:youtube": "web-ext build --source-dir extensions/youtube/src --artifacts-dir dist --overwrite-dest --filename peacebestill-youtube.zip",
    "start:firefox": "web-ext run --source-dir extensions/youtube/src --start-url https://www.youtube.com",
    "start:chromium": "web-ext run --source-dir extensions/youtube/src --target chromium --start-url https://www.youtube.com",
    "audit:chromium": "node extensions/youtube/audit/chromium.mjs",
    "audit:firefox": "node extensions/youtube/audit/firefox.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "puppeteer-core": "^25.9.0",
    "web-ext": "^10.6.0"
  }
}
